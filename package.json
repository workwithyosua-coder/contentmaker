{
  "name": "content-platform",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "db:setup": "tsx --env-file-if-exists=.env.local scripts/db-setup.mts",
    "db:seed": "tsx --env-file-if-exists=.env.local scripts/seed-demo.mts",
    "typecheck": "next typegen && tsc --noEmit",
    "test:integration": "for f in tests/integration/*.test.mts; do echo \"== $f\"; tsx --conditions=react-server --tsconfig tsconfig.json \"$f\" || exit 1; done",
    "prebuild": "tsx scripts/asset-manifest.mts",
    "assets": "tsx scripts/asset-manifest.mts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.8.0",
    "next": "16.4.6",
    "postgres": "^4.1.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "recharts": "^3.10.1",
    "server-only": "^0.0.1",
    "zod": "^4.6.7",
    "@remotion/player": "4.0.544",
    "remotion": "4.0.544"
  },
  "devDependencies": {
    "@tailwindcss/turbopack": "4.3.3",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.6",
    "tailwindcss": "4.3.3",
    "tsx": "^4.23.15",
    "typescript": "^5"
  },
  "workspaces": [
    "video"
  ]
}
