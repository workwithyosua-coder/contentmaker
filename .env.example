# Postgres with pgvector. Supabase: use the transaction pooler URL (port 6543). Local example:
DATABASE_URL=postgres://postgres@localhost:5432/studio
# Your Claude API key (console.anthropic.com) — needed for the Analyst agent
ANTHROPIC_API_KEY=
# Optional: which user the app shows (defaults to the first user)
OWNER_EMAIL=
# Password to unlock the app (required; the app stays locked if this is empty)
APP_PASSWORD=
